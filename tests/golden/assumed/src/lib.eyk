// verify が verified と表示する根拠（Verus の func-details）を確かめる例（PR #26 のレビュー）。
// Verus が見ない項目（#[cfg] で消える、#[test]）を verified と出さず、証明なしの前提を必ず出す。

// unchecked の前提。これを呼ぶ caller は、前提のもとで verified。
unchecked fn liar(x: u64) -> (r: u64) ensures r == 7, { x }
pub fn caller(x: u64) -> (r: u64) ensures r == 7, { liar(x) }

// 本体のない補題（admit）。
lemma fn helper(x: u64) ensures x + 0 == x;

// `#[cfg]` で消える項目。Verus は見ないので unknown（verify は失敗する）。`verus_keep_ghost` で Verus の
// ときだけ消す書き方は、拒否リストで書けない（#27）。
#[cfg(any())]
pub fn hidden(x: u32) -> (r: u32) ensures r == 0, { x }

// #[test] は #[verifier::external] になり、Verus は見ない。
#[test]
fn t() {}

// 同じパス（Verus の名前 assumed::S::e）になる二つの項目：trait の impl のメソッドと、`#[cfg]` で
// 消える固有のメソッド。Verus の証拠がどちらのものか分からないので、両方 unknown。
pub trait Tr { fn e(&self) -> u32; }
pub struct S { pub v: u32 }
impl Tr for S { fn e(&self) -> u32 { 1 } }
impl S {
    #[cfg(any())]
    pub fn e(&self) -> (r: u32) ensures r == 0, { 1 }
}

// クレートの外の型への impl のメソッド。Verus の名前は assumed::impl&%N::f。
pub trait Tr2 { fn f(&self) -> u32; }
impl Tr2 for u32 { fn f(&self) -> u32 { 2 } }
