// 実行関数の `decreases` は任意（設計ノート §4.3、#81）。書き下しは、本体を検証する実行関数に
// `#[verifier::exec_allows_no_decreases_clause]` を付ける。`decreases` のないループと再帰は停止を示さずに
// 検証し、書いた `decreases` は確かめる（`stuck` は減らないので failed）。`spec fn` の再帰は今までどおり
// `decreases` が要る。

pub fn halve_to_zero(x: u64) -> (r: u64)
    ensures r == 0,
{
    let mut y = x;
    while y > 0 {
        y = y / 2;
    }
    y
}

pub fn count_down(n: u64) -> (r: u64)
    ensures r == 0,
{
    if n == 0 { 0 } else { count_down(n - 1) }
}

pub fn halve_checked(x: u64) -> (r: u64)
    ensures r == 0,
{
    let mut y = x;
    while y > 0
        decreases y,
    {
        y = y / 2;
    }
    y
}

pub fn stuck(x: u64) -> u64 {
    let mut y = x;
    while y > 0
        decreases y,
    {
        y = y + 0;
    }
    y
}

pub spec fn tri(n: nat) -> nat
    decreases n,
= if n == 0 { 0 } else { n + tri((n - 1) as nat) };

pub struct Counter { pub n: u64 }

impl Counter {
    pub fn drain(&mut self)
        ensures final(self).n == 0,
    {
        while self.n > 0 {
            self.n = self.n - 1;
        }
    }
}

unchecked fn spin() {
    loop {}
}
