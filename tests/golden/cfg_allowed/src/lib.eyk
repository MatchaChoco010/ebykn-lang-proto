// 拒否リスト（#27）にない cfg は、関数の中、マクロの引数の中、`cfg_attr` の条件に書ける。書き下しが属性を
// 落とさないこと（落とすと、Verus が検証する値が変わる）を、Verus の結果で確かめる。どれも、`test` も
// `feature = "never"` もない設定で検証する。
//
// ここで食い違わないのは、Verus の検証と、同じホスト・既定の feature・追加の `--cfg` なし・`test` なしの
// ビルドのあいだだけ。別の target、別の feature、`RUSTFLAGS` の `--cfg`、`cargo test` でビルドすると、検証
// したのと別のコードになる（#87）。そのため verify は、頼っている cfg の名前を `assumed cfg ..` の前提の行に出す。

fn side(x: &mut u32) ensures *final(x) == 7, { *x = 7; }

pub fn f() -> (r: u32) ensures r == 1, { if cfg!(test) { 0 } else { 1 } }

// 呼び出し・ブロック・if・while の文は、消えても §6 の権限の状態が変わらない。
pub fn g() -> (r: u32) ensures r == 0, { let mut x = 0u32; #[cfg(test)] side(&mut x); x }

pub fn g2() -> (r: u32) ensures r == 7, { let mut x = 0u32; #[cfg(not(test))] side(&mut x); x }

pub fn g3() -> (r: u32) ensures r == 0, { let mut x = 0u32; #[cfg(test)] { x = 1; } x }

pub fn g4(v: u32) -> (r: u32) ensures r == 0, { #[cfg(test)] if v > 0 { return 1; } 0 }

pub fn h(x: u32) -> (r: u32) ensures r == 2, { match x { #[cfg(test)] 0 => 1, _ => 2 } }

pub fn p() -> (r: usize) ensures r == 1, { let v: Vec<u32> = vec![#[cfg(test)] 1u32, 0]; v.len() }

pub struct P { pub a: u32, #[cfg(test)] pub b: u32 }

pub fn m() -> (r: P) ensures r.a == 1, { P { a: 1, #[cfg(test)] b: 2 } }

pub fn n() -> (r: u32) ensures r == 3, { #[cfg(feature = "never")] let x = 1u32; #[cfg(not(feature = "never"))] let x = 3u32; x }

#[cfg_attr(test, inline)]
pub fn k() -> (r: u32) ensures r == 4, { 4 }

// 利用者の付けた `--cfg` の名前と target の cfg（PR #59 の再レビュー）。どちらも前提の行に出る。
pub fn u() -> (r: u32) ensures r == 0, { if cfg!(my_flag) { 1 } else { 0 } }

pub fn t64() -> (r: u32) ensures r == 0, { if cfg!(target_pointer_width = "64") { 0 } else { 1 } }
